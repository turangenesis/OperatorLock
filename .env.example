# ============================================================
#  OperatorLock — Environment Variable Reference
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
#  Flask
# ------------------------------------------------------------

# Secret key for Flask session signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-string

# ------------------------------------------------------------
#  Authentication
# ------------------------------------------------------------

# Password for the operator dashboard (single-user gate).
DASHBOARD_PASSWORD=replace-with-a-strong-password

# ------------------------------------------------------------
#  TradingView Webhooks
# ------------------------------------------------------------

# Shared secret appended to TradingView webhook URLs for validation.
TV_WEBHOOK_SECRET=replace-with-webhook-secret

# ------------------------------------------------------------
#  VPS Bridge → Heroku Communication
# ------------------------------------------------------------

# HMAC secret used by the C# VPS bridge when posting to /api/bridge/heartbeat
# and when fetching /api/orders/pending. Must match Config.secrets.cs in the bridge.
BRIDGE_HEARTBEAT_SECRET=replace-with-bridge-secret

# ------------------------------------------------------------
#  Google Cloud / Firestore
# ------------------------------------------------------------

# Full JSON contents of your Firebase service account key file.
# In Heroku: set this as a config var (paste the JSON as a single line).
# Locally: you can also set GOOGLE_APPLICATION_CREDENTIALS to the file path instead.
GOOGLE_CLOUD_CREDENTIALS={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"..."}

# ------------------------------------------------------------
#  Optional Tuning
# ------------------------------------------------------------

# How long the VPS bridge holds a lease on a pending order (seconds).
# Default: 200. Increase if your bridge polls infrequently.
ORDER_LEASE_SECONDS=200
